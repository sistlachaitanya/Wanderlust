<% layout("layouts/boilerplate.ejs") -%>

<div class="row mt-5">
  <div class="col-6 offset-3">
    <h3>Email Verification</h3>

    <p class="mt-3">We sent an OTP to your email. Enter it below:</p>

    <form action="/verify/<%= userId %>" method="POST">
      <div class="mb-3">
        <label for="otp" class="form-label">Enter OTP</label>
        <input
          name="otp"
          id="otp"
          type="text"
          class="form-control"
          placeholder="6-digit OTP"
          required
        />
      </div>

      <button class="btn btn-primary mt-2">Verify</button>
    </form>

    <form class="mt-3" action="/resend-otp/<%= userId %>" method="POST">
      <button class="btn btn-secondary btn-sm">Resend OTP</button>
    </form>
  </div>
</div>
